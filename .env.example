# Copy to .env next to watches.toml. Never commit .env. Leave a channel empty to disable it.

# Telegram: create a bot with @BotFather, message it once, then find your chat id at
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (any SMTP server, e.g. Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
